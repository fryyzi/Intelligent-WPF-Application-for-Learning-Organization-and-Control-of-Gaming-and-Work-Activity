<Window x:Class="Wizzy.Pages.AIChat.AiChat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wizzy.Pages.AIChat"
        mc:Ignorable="d"
        Title="AiChat" Height="450" Width="800">
    <Grid>
        <ScrollViewer x:Name="ChatScroll"
                  VerticalScrollBarVisibility="Auto"
                  Margin="10,10,10,65">
            <StackPanel x:Name="ChatPanel" />
        </ScrollViewer>

        <DockPanel VerticalAlignment="Bottom" Height="50">
            <TextBox x:Name="AiInput"
                 Margin="20,0"
                 Width="400"
                 Height="30"/>

            <Button x:Name="AiSend"
                Content="Відправити"
                Height="30"
                Margin="20,0"
                Click="AiSend_Click"/>
        </DockPanel>
    </Grid>

</Window>
