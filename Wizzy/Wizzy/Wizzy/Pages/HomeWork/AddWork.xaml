<Window x:Class="Wizzy.Pages.HomeWork.AddWork"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wizzy.Pages.HomeWork"
        mc:Ignorable="d"
        Title="AddWork" Height="402" Width="386">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- "Назва" -->
            <RowDefinition Height="Auto"/>
            <!-- Поле для назви -->
            <RowDefinition Height="Auto"/>
            <!-- "Опис" -->
            <RowDefinition Height="*"/>
            <!-- Поле для опису -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock 
            Text="Добавити завдання" 
            FontSize="20"
            HorizontalAlignment="Center"
            Grid.Row="0"
            Margin="0 0 0 10"/>

        <!-- Назва -->
        <TextBlock 
            Text="Назва"
            FontSize="15"
            Grid.Row="1"
            Margin="0 0 0 5"/>

        <TextBox 
            x:Name="TitleHomeWorkTextBox"
            Padding="5"
            Grid.Row="2"
            Margin="0 0 0 10"/>

        <!-- Опис -->
        <TextBlock 
            Text="Опис"
            FontSize="15"
            Grid.Row="3"
            Margin="0 0 0 5"/>

        <TextBox 
            x:Name="DescriptionHomeWorkTextBox"
            Grid.Row="4"
            AcceptsReturn="True"
            VerticalScrollBarVisibility="Auto"
            Padding="5"
            Margin="0 0 0 10"/>

        <!-- Кнопка -->
        <Button x:Name="AddHomeWorkButton"
            Content="Добавити"
            FontSize="12"
            HorizontalAlignment="Right"
            Width="100"
            Margin="0 5 0 0"
            Grid.Row="5"
            Click="AddHomeWorkButton_Click"/>
    </Grid>
</Window>
