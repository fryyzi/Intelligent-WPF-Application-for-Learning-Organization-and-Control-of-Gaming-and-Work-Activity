<Window x:Class="Wizzy.Pages.HomeWork.EditHomeWork"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wizzy.Pages.HomeWork"
        mc:Ignorable="d"
        Title="EditHomeWork" Height="450" Width="800">
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="*"/>
            <!-- Текст -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- Поле заголовку -->
        <TextBox 
            x:Name="EditTitleHomeWorkTextBlock"
            Text="Title"
            FontSize="25"
            HorizontalAlignment="Center"
            Width="250"
            Margin="0,0,0,10"
            Grid.Row="0"
        />

        <!-- Поле редагування тексту -->
        <TextBox
            x:Name="EditDespenshionTextBlock" 
            Text="Редагувати нотатку"
            FontSize="16"
            TextWrapping="Wrap"
            AcceptsReturn="True"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Grid.Row="1"
        />

        <!-- Кнопки управління -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button 
                Content="Видалити" 
                FontSize="16"
                Width="120" Height="40"
                Margin="0,0,10,0"
                Click="DeleteButton_Click"
            />
            <Button 
                x:Name="SaveButton"
                Content="Зберегти"
                FontSize="16"
                Width="120" Height="40"
                Click="SaveButton_Click"
            />
        </StackPanel>

    </Grid>
</Window>
