<UserControl x:Class="Wizzy.Pages.tools.ToolsContent"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wizzy.Pages.tools"
      mc:Ignorable="d" 
      d:DesignHeight="450" Background="AliceBlue" Width="597"
      >

    <Grid Margin="0,0,0,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <Button Content="Калькулятор обрахування середнього балу"  
                    FontSize="16"
                    Height="35" 
                    VerticalAlignment="Top"
                    Margin="10"
                    HorizontalAlignment="Left"  
                    Width="350"
                    Grid.Column="0"
                    Grid.Row="0"
                    />
        <Button x:Name="Convert"
                Content="Конвертер одиниць"
                FontSize="16"
                Height="35" 
                VerticalAlignment="Top"
                Margin="10"
                HorizontalAlignment="Left"  
                Width="200"
                Grid.Column="1"
                Grid.Row="0" Click="Convert_Click"
                />
        <Button
            Content="Таймер"
            FontSize="16"
            Height="35"
            Width="150"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Margin="10"
            Click="TimerButton_Click"
            Grid.Column="0"
            Grid.Row="1"
            />
        <Button
            x:Name="PomodoroButton"
            Content="Pomodoro"
            FontSize="16"
            Margin="10"
            Height="35"
            Width="150"
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            Grid.Column="0"
            Grid.Row="1" Click="PomodoroButton_Click"  
            />
        <Button 
            x:Name="PasswordGenerator"
            Content="Генератор паролів"
            Margin="10"
            FontSize="16"
            Height="35"
            Width="150"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Grid.Column="1"
            Grid.Row="1" Click="PasswordGenerator_Click"
            />
        <Button
            Content="Калькулятор"
            Margin="10"
            FontSize="16"
            Height="35"
            Width="150"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Grid.Column="0"
            Grid.Row="2"
            Click="Calculator_Click"
            />
    </Grid>
</UserControl>
