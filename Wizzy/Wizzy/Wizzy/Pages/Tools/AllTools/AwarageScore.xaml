<Window x:Class="Wizzy.Pages.Tools.AllTools.AwarageScore"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Середній бал"
        Height="350"
        Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        ResizeMode="NoResize">

    <Grid>
        <!-- Card Container -->
        <Border Width="380"
                Padding="25"
                CornerRadius="15"
                Background="White"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="2"
                                  Opacity="0.2"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Обчислення середнього балу"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"
                           Foreground="#111827"/>

                <TextBlock Text="Сума оцінок"
                           FontSize="14"
                           Foreground="#6B7280"/>

                <TextBox x:Name="SumTextBlock"
                         Height="40"
                         Margin="0,5,0,15"
                         FontSize="14"
                         Padding="10"
                         BorderBrush="#E5E7EB"
                         BorderThickness="1"
                         Background="#F9FAFB"
                         CaretBrush="#2563EB"
                         />

                <TextBlock Text="Кількість оцінок"
                           FontSize="14"
                           Foreground="#6B7280"/>

                <TextBox x:Name="NumberOfRaiting"
                         Height="39"
                         Margin="0,5,0,20"
                         FontSize="14"
                         Padding="10"
                         BorderBrush="#E5E7EB"
                         BorderThickness="1"
                         Background="#F9FAFB"
                         CaretBrush="#2563EB"/>

                <Button Content="Обчислити"
                        Height="40"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" Click="Button_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>