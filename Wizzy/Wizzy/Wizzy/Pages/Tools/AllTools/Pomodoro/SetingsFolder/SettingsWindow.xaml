<Window x:Class="Wizzy.Pages.Tools.AllTools.Pomodoro.SetingsFolder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wizzy.Pages.Tools.AllTools.Pomodoro.SetingsFolder"
        mc:Ignorable="d"
        Title="SettingsWindow" Height="451" Width="769">
    <Grid>
        <StackPanel
            Background="Black"
            HorizontalAlignment="Left"
            Width="181"
            >
            <Button
                x:Name="TimerSettings"
                Margin="20"
                Content="Таймер"
                FontSize="20" Click="TimerSettings_Click"
                />
            <Button
                Margin="10 0"
                Content="Зайдній фон"
                FontSize="20" Click="Button_Click"
                />
        </StackPanel>
        <UserControl x:Name="ControlSetting" Margin="181,0,0,0" Height="435" Width="581"/>
    </Grid>
</Window>
