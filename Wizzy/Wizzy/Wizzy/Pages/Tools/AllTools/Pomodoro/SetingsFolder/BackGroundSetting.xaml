<Window x:Class="Wizzy.Pages.Tools.AllTools.Pomodoro.SetingsFolder.BackGroundSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wizzy.Pages.Tools.AllTools.Pomodoro.SetingsFolder"
        mc:Ignorable="d"
        Title="BackGroundSetting" Height="450" Width="800">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,10,10,60">
            <WrapPanel x:Name="MainGrid" />
        </ScrollViewer>

        <Button
            x:Name="AddImage"
            Content="Добавити картинку"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            FontSize="16"
            Margin="0,0,10,10"
            Height="40"
            Width="200"
            Click="AddImage_Click"/>
    </Grid>
</Window>
