        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wizzy.Pages.Tools.AllTools.Pomodoro.SetingsFolder.AllSetings"
        mc:Ignorable="d"
        Height="77" Width="285" Background="White">
    <Grid>
        <Button x:Name="WhiteButton" Content="White" Background="White" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="50" Width="123" Click="WhiteButton_Click"/>
