<Window x:Class="Wizzy.Pages.Tools.AllTools.Pomodoro.SetingsFolder.AddImage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wizzy.Pages.Tools.AllTools.Pomodoro.SetingsFolder"
        mc:Ignorable="d"
        Title="AddImage" Height="128" Width="341">
    <Grid>
        <TextBlock
            Text="URL" 
            Margin="0,17,308,0" 
            HorizontalAlignment="Right" 
            Width="23" 
            Height="17" 
            VerticalAlignment="Top"/>
        <TextBox
            x:Name="UrlImage"
            Margin="0,34,0,0" 
            HorizontalAlignment="Center" 
            Width="321" 
            Height="25" 
            VerticalAlignment="Top"/>
        <Button
            x:Name="AddImageButton"
            Content="Добавити"
            VerticalAlignment="Top"
            HorizontalAlignment="Center" 
            Height="23" 
            Width="172" 
            Margin="0,64,0,0" 
            Click="AddImage_Click"/>
    </Grid>
</Window>
