<UserControl x:Class="Wizzy.Pages.Tools.AllTools.Pomodoro.Setings.SettingTIme"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             Height="435" Width="581" 
             Background="#F8FAFC" x:Name="UserControlSettings">

    <UserControl.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="45">
        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="Налаштування часу" 
                       FontSize="26" 
                       FontWeight="Bold" 
                       Foreground="#1E293B" 
                       Margin="0,0,0,30"/>

            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Тривалість роботи (хвилини):" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="WorkDurationTextBox" Width="120" HorizontalAlignment="Left"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Коротка перерва (хвилини):" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="ShortBreakDurationTextBox" Width="120" HorizontalAlignment="Left"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Довга перерва (хвилини):" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="LongBreakDurationTextBox" Width="120" HorizontalAlignment="Left"/>
            </StackPanel>
        </StackPanel>

        <Button Content="Зберегти зміни" 
                Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Width="160"
                Click="SaveButton_Click">
            <Button.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.15"/>
            </Button.Effect>
        </Button>
    </Grid>
</UserControl>