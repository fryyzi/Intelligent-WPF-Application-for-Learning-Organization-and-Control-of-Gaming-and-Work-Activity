<UserControl x:Class="Wizzy.Pages.Tools.AllTools.Pomodoro.Setings.SettingTIme"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wizzy.Pages.Tools.AllTools.Pomodoro.Setings"
        mc:Ignorable="d"
        Height="435" Width="581" Background="AliceBlue" x:Name="UserControlSettings">
    <Grid>
        <TextBlock 
        Text="Work Duration (minutes):" 
        Margin="10,10,0,0"
        HorizontalAlignment="Left" 
        VerticalAlignment="Top"/>
        <TextBox x:Name="WorkDurationTextBox" 
             Width="50" 
             Height="25" 
             Margin="150,10,0,0" 
             HorizontalAlignment="Left" 
             VerticalAlignment="Top"/>
        <TextBlock 
             Text="Short Break Duration (minutes):" 
                Margin="10,50,0,0" 
        HorizontalAlignment="Left" 
        VerticalAlignment="Top"/>
        <TextBox 
        x:Name="ShortBreakDurationTextBox" 
        Width="50" 
        Height="25" 
        Margin="200,50,0,0" 
        HorizontalAlignment="Left" 
        VerticalAlignment="Top"/>
        <TextBlock 
        Text="Long Break Duration (minutes):"
        Margin="10,90,0,0" 
        HorizontalAlignment="Left" 
        VerticalAlignment="Top"/>
        <TextBox 
        x:Name="LongBreakDurationTextBox" 
        Width="50" 
        Height="25" 
        Margin="200,90,0,0" 
        HorizontalAlignment="Left"
        VerticalAlignment="Top"/>
        <Button 
        Content="Save" 
        Width="100" 
        Height="30" 
        HorizontalAlignment="Right" 
        VerticalAlignment="Bottom" 
        Margin="0,0,20,20" 
        Click="SaveButton_Click"/>
    </Grid>
</UserControl>
