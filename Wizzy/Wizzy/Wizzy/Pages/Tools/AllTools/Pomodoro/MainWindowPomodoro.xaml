<Window x:Class="Wizzy.Pages.Tools.AllTools.Pomodoro.MainWindowPomodoro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wizzy.Pages.Tools.AllTools.Pomodoro"
        mc:Ignorable="d"
        Title="Pomodoro Timer" Height="450" Width="800">
    <Grid x:Name="MainGrid">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label
                x:Name="TimerLabel"
                Content="25:00:00"
                FontSize="40"
                FontWeight="Bold"
                HorizontalAlignment="Center"/>
            <StackPanel 
                Orientation="Horizontal" 
                HorizontalAlignment="Center">
                <Button
                    x:Name="StartButton"
                    Content="Start"
                    Width="100"
                    Height="40"
                    Click="StartButton_Click"/>
                <Button
                    x:Name="PauseButton"
                    Content="Pause"
                    Width="100"
                    Height="40"
                    Click="PauseButton_Click"/>
                <Button
                    x:Name="ResetButton"
                    Content="Reset"
                    Width="100"
                    Height="40"
                    Click="ResetButton_Click"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Height="43" VerticalAlignment="Top" HorizontalAlignment="Left" Width="52">
            <Image 
                Source="F:\programing\Project\Wizzy\Wizzy\Wizzy\Pages\Tools\AllTools\Pomodoro\Image\Tomato.ico" 
                Width="30" 
                Height="30"/>
            <Label
                x:Name="SessionCountLabel"
                Content="0" 
                Height="26"
                />
        </StackPanel>
        <Button Height="27" VerticalAlignment="Top" HorizontalAlignment="Right" Width="34" Click="Button_Click">
            <Image Source="F:\programing\Project\Wizzy\Wizzy\Wizzy\Pages\Tools\AllTools\Pomodoro\Image\setting.ico"/>
        </Button>
        <ContentControl 
            x:Name="SettingControl" Height="434" VerticalAlignment="Top" HorizontalAlignment="Center" SizeChanged="SettingControl_SizeChanged"/>
    </Grid>
</Window>
