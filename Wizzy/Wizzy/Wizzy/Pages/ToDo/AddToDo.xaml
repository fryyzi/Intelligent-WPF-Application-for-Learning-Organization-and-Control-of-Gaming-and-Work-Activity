<Window x:Class="Wizzy.Pages.ToDo.AddToDo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wizzy.Pages.ToDo"
        mc:Ignorable="d"
        Title="AddToDo" Height="445" Width="484">
    <Grid Margin="0,0,0,-16">
        <TextBlock Text="Добавити нотатку" FontSize="20 " HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,80,0,0" TextWrapping="Wrap" Text="Назва" FontSize="25" VerticalAlignment="Top"/>
        <TextBox x:Name="NewMainToDoListTextBox" HorizontalAlignment="Left" Margin="83,80,0,0" TextWrapping="Wrap" FontSize="20" VerticalAlignment="Top" Width="373" Height="35"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,137,0,0" TextWrapping="Wrap" Text="Нагадування" FontSize="20 " VerticalAlignment="Top"/>
        <TextBox x:Name="NewToDoTextBox" HorizontalAlignment="Center" Margin="0,164,0,0" TextWrapping="Wrap" FontSize="20" VerticalAlignment="Top" Width="464" Height="199"/>
        <Button Content="Добавити" FontSize="20" HorizontalAlignment="Left" Margin="318,368,0,0" VerticalAlignment="Top" Height="46" Width="156" Click="AddButtonNewToDoListClick" />

    </Grid>
</Window>
