<Window x:Class="Wizzy.Pages.ToDo.AddToDo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавити нотатку"
        Height="520" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#f7f7f7">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Назва -->
            <RowDefinition Height="Auto"/>
            <!-- Нагадування -->
            <RowDefinition Height="*"/>
            <!-- Текст -->
            <RowDefinition Height="Auto"/>
            <!-- Налаштування + кнопка -->
        </Grid.RowDefinitions>

        <TextBlock Text="Добавити нотатку" 
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Назва:"
                       FontSize="18"
                       VerticalAlignment="Center"
                       Width="70"/>
            <TextBox x:Name="NewMainToDoListTextBox"
                     FontSize="18"
                     Width="380"
                     MaxLength="30"/>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="Нагадування"
                   FontSize="18"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,10"/>

        <TextBox x:Name="NewToDoTextBox"
                 Grid.Row="3"
                 FontSize="16"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Padding="5"/>

        <DockPanel Grid.Row="4" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" >
                <CheckBox x:Name="IsCodeCheckBox"
                          Content="Це код"
                          FontSize="14"
                          Margin="0,0,15,0" Checked="IsCodeCheckBox_Checked" Unchecked="IsCodeCheckBox_Unchecked"/>
                <ComboBox x:Name="LanguageComboBox"
                          Width="140"
                          FontSize="14"
                          Visibility="Hidden"
                          />
            </StackPanel>

            <Button x:Name="AddToDoList"
                    Content="➕ Добавити"
                    FontSize="18"
                    FontWeight="Bold"
                    Width="180"
                    Height="45"
                    HorizontalAlignment="Right"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="AddButtonNewToDoListClick"/>
        </DockPanel>
    </Grid>
</Window>
