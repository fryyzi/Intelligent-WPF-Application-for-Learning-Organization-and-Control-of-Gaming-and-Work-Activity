<Window x:Class="Wizzy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wizzy"
        mc:Ignorable="d"
        Title="Wizzy" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#FFF"
        Loaded="Window_Loaded">

    <Grid>
        <DockPanel Width="200" Background="#2D2D30" HorizontalAlignment="Left">
            <StackPanel DockPanel.Dock="Top" Margin="10">
                <TextBlock Text="SmartAssistant" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,10,0,20"/>
                <Grid>
                    <Button Content="Планувальник" VerticalAlignment="Center" Margin="0,5,36,5" Height="35" Click="ToDoListButton"/>
                    <Button Content="+" Margin="144,5,0,5" Click="AddToDoList"/>
                </Grid>
                <Button Content="Розклад"  Margin="0,5" Height="35"/>
                <Grid>
                    <Button Content="Домашні завдання" Margin="0,5,36,5" Height="35" Click="ViewHomeWork" />
                    <Button Content="+" Margin="144,5,0,5" Click="AddHomeWork"/>
                </Grid>
                <Button Content="Нотатки" Margin="0,5" Height="35" />
                <Button Content="Інструменти" Margin="0,5" Height="35" Click="ToolsButton"/>
                <Button Content="Налаштування" Margin="0,20,0,0" Height="35"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="10" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                <Button x:Name="AiChatButton"
                    Width="36"
                    Height="36"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip="AI Чат"
                    Click="AiChatButton_Click">
                    <Image Source="F:\programing\Project\Wizzy\Wizzy\Wizzy\Pages\Image\Chat_Ai.ico"
                    Stretch="Uniform"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <Grid Margin="200,0,0,0">
            <ContentControl x:Name="MainContent" Width="600" Margin="0,2,0,0"/>
        </Grid>
    </Grid>
</Window>
