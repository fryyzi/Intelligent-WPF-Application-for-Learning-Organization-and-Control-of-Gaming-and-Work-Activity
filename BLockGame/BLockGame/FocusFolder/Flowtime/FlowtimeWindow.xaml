<Window x:Class="BLockGame.FocusFolder.Flowtime.FlowtimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Flowtime Session" Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#0F1116" AllowsTransparency="True" WindowStyle="None">

    <Window.Resources>
        <DropShadowEffect x:Key="GlowEffect" BlurRadius="20" ShadowDepth="0" Color="#3498DB" Opacity="0.6"/>
    </Window.Resources>

    <Border CornerRadius="20" BorderBrush="#1C1F26" BorderThickness="2" Background="#0F1116" Margin="0,0,0,-35">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" 
                        Foreground="#555" BorderThickness="0" Click="Close_Click" Cursor="Hand"/>
                <TextBlock Text="WAVE FLOW" HorizontalAlignment="Center" Foreground="#3498DB" 
                           FontSize="14" FontWeight="Bold"/>
            </StackPanel>

            <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Ellipse Width="220" Height="220" Stroke="#1C1F26" StrokeThickness="8"/>
                <Ellipse Width="220" Height="220" Stroke="#3498DB" StrokeThickness="8" 
                         StrokeDashArray="10 2" Effect="{StaticResource GlowEffect}"/>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TimerText" Text="00:00:00" Foreground="White" 
                               FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TextTime" Text="ЧАС У ПОТОЦІ" Foreground="#555E6B" 
                               FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button x:Name="StartBtn" Content="▶" Width="60" Height="60" Margin="10"
                        Background="#3498DB" Foreground="White" FontSize="20"
                        Click="Start_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="30">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="StopBtn" Content="⬛" Width="60" Height="60" Margin="10"
                        Background="#E74C3C" Foreground="White" FontSize="20"
                        Click="Stop_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="30">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <Border Grid.Row="3" Background="#1C1F26" CornerRadius="12" Padding="15">
                <StackPanel>
                    <TextBlock Text="Перерви:" Foreground="#BDC3C7" FontSize="12"/>
                    <TextBlock  Text="1. Менше 25 хв - перерва 5 хв" 
                               Foreground="White" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    <TextBlock  Text="2. 25-50 хв - перерва 8 хв " 
           Foreground="White" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    <TextBlock  Text="3. 50-90 хв - перерва 10 - 15 ха" 
           Foreground="White" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    <TextBlock  Text="4. Більше 90 хв -  перерва 20 хв" 
           Foreground="White" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>