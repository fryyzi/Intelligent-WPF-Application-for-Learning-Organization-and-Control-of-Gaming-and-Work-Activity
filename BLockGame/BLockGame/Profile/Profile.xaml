<Window x:Class="BLockGame.Profile.Profile" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:BLockGame.Profile" 
        mc:Ignorable="d" 
        Title="Profile" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None">

    <Border CornerRadius="25" BorderBrush="#1C1F26" BorderThickness="2" Background="#0F1116" Margin="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Button Content="← Назад" HorizontalAlignment="Left" Background="Transparent" 
                        Foreground="#7F8C8D" BorderThickness="0" FontSize="12" Cursor="Hand" Click="Back_Click"/>

                <Button Content="Налаштування ⚙" HorizontalAlignment="Right" Background="Transparent" 
                        Foreground="#3498DB" BorderThickness="0" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Click="Settings_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10">

                <TextBlock x:Name="UserNickname" Text="PROG_WARRIOR" Foreground="White" 
                           FontSize="26" FontWeight="Black" HorizontalAlignment="Center" />

                <Rectangle Height="3" Fill="#3498DB" HorizontalAlignment="Center" Width="50" Margin="0,10,0,20"/>

                <Border Background="#16181D" CornerRadius="12" Padding="15" BorderBrush="#1C1F26" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ПРО КОРИСТУВАЧА" Foreground="#555E6B" FontSize="10" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock x:Name="UserDescription" Foreground="#BDC3C7" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                   Text="Студент-розробник. Знищую баги, пишу чистий код на C# та оптимізую свій час за допомогою глибокого фокусу. Жодної прокрастинації."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </Border>
</Window>