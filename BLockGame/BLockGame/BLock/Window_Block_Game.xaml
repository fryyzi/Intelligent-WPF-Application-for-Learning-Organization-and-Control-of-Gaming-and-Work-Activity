<Window x:Class="BLockGame.Window_Block_Game"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вікно блокування"
        Height="650"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F1116"
        FontFamily="Segoe UI">

    <Grid Margin="20">

        <!-- HEADER -->
        <TextBlock Text="🔒 Блокування гри"
                   Foreground="White"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="10,10,0,0"/>

        <!-- MAIN CARD -->
        <Border Background="#151821"
                CornerRadius="15"
                Margin="0,60,0,80">

            <StackPanel Margin="25" >

                <!-- PROCESS NAME -->
                <TextBlock Text="Назва процесу (.exe)"
                           Foreground="Gray"
                           FontSize="14"/>

                <TextBox x:Name="Id_Game"
                         Height="40"
                         Margin="0,5,0,15"
                         Background="#222634"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="10"/>

                <!-- GAME NAME -->
                <TextBlock Text="Назва гри"
                           Foreground="Gray"
                           FontSize="14"/>

                <TextBox x:Name="NameBlockGameTextBox"
                         Height="40"
                         Margin="0,5,0,15"
                         Background="#222634"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="10"/>

                <!-- DAY -->
                <TextBlock Text="День"
                           Foreground="Gray"
                           FontSize="14"/>

                <ComboBox x:Name="DayComboBox"
                          Height="40"
                          Margin="0,5,0,20"
                          Background="#222634"
                          Foreground="White"
                          BorderThickness="0"/>

                <!-- TIME TOGGLE -->
                <CheckBox x:Name="TimeCheckBox"
                          Content="Встановити час"
                          Foreground="White"
                          FontSize="16"
                          Margin="0,0,0,15"
                          Checked="TimeCheckBox_Checked"
                          Unchecked="TimeCheckBox_Unchecked_1"/>

                <!-- TIME PANEL -->
                <StackPanel Orientation="Horizontal">

                    <StackPanel Margin="0,0,15,0">
                        <TextBlock x:Name="StartLable"
                                   Text="Від"
                                   Foreground="Gray"
                                   Visibility="Hidden"/>
                        <TextBox x:Name="StartTimeTextBox"
                                 Width="120"
                                 Height="35"
                                 Background="#222634"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Padding="5"
                                 Visibility="Hidden"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock x:Name="EndLable"
                                   Text="До"
                                   Foreground="Gray"
                                   Visibility="Hidden"/>
                        <TextBox x:Name="EndTimeTextBox"
                                 Width="120"
                                 Height="35"
                                 Background="#222634"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Padding="5"
                                 Visibility="Hidden"/>
                    </StackPanel>

                </StackPanel>

            </StackPanel>
        </Border>

        <!-- BUTTONS -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,10,10">

            <!-- BACK -->
            <Button x:Name="ExitButton"
                    Content="Назад"
                    Width="140"
                    Height="45"
                    Margin="10"
                    Background="#BF616A"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="ExitButton_Click">

                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#BF616A"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D9777F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- APPLY -->
            <Button Content="Застосувати"
                    Width="160"
                    Height="45"
                    Background="#3A6FF7"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Button_Click">

                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#3A6FF7"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A86FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>

        <!-- STEAM BUTTON -->
        <Button Content="Steam"
                Width="120"
                Height="40"
                Background="#222634"
                Foreground="White"
                BorderThickness="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10"
                Click="Button_Click_1"/>

    </Grid>
</Window>