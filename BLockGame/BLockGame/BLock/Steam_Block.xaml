<Window x:Class="BLockGame.Team_Block"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam_Block"
        Height="550"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F1116"
        FontFamily="Segoe UI">

    <Grid Margin="20">

        <!-- HEADER -->
        <TextBlock Text="Steam Game Manager"
                   Foreground="White"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Left"
                   Margin="10,10,0,0"/>

        <!-- SEARCH -->
        <Border Background="#1A1D24"
                CornerRadius="10"
                Height="45"
                Margin="0,60,0,0"
                VerticalAlignment="Top">

            <TextBox x:Name="SearchGame"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     FontSize="16"
                     Padding="10"
                     TextChanged="SearchGame_TextChanged"
                     VerticalContentAlignment="Center"/>
        </Border>

        <!-- GAME LIST -->
        <Border Background="#151821"
                CornerRadius="12"
                Margin="0,120,0,180">

            <ListBox x:Name="ListSteamGame"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     MouseDoubleClick="ListSteamGame_MouseDoubleClick"
                     SelectionChanged="ListSteamGame_SelectionChanged"/>
        </Border>

        <!-- BOTTOM PANEL -->
        <Border Background="#151821"
                CornerRadius="12"
                Height="140"
                VerticalAlignment="Bottom">

            <Grid Margin="15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- DAY -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="День"
                               Foreground="Gray"
                               Margin="5"/>

                    <ComboBox x:Name="DayComboBox"
                              Height="35"
                              Background="#222634"
                              Foreground="Black"
                              BorderThickness="0"/>
                </StackPanel>

                <!-- TIME FROM -->
                <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock Text="Від"
                               Foreground="Gray"
                               Margin="5"/>

                    <TextBox x:Name="MinDay"
                             Height="35"
                             Background="#222634"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="10"/>
                </StackPanel>

                <!-- TIME TO -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="До"
                               Foreground="Gray"
                               Margin="5"/>

                    <TextBox x:Name="MaxDay"
                             Height="35"
                             Background="#222634"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="10"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- APPLY BUTTON -->
        <Button x:Name="Continu"
                Content="Застосувати"
                Width="160"
                Height="45"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,10,10"
                Click="Button_Click"
                Background="#3A6FF7"
                Foreground="White"
                BorderThickness="0"
                FontSize="16"
                FontWeight="Bold">

            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#3A6FF7"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#5A86FF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#2E56C7"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>