<Window x:Class="BLockGame.UnBlock"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Розблокування"
        Height="500"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#0F1116"
        FontFamily="Segoe UI">

    <Grid Margin="20">

        <TextBlock Text="🔓 Розблокування програм"
                   Foreground="White"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="10"/>

        <Border Background="#151821"
                CornerRadius="15"
                Margin="0,60,0,0">

            <StackPanel Margin="25">

                <TextBlock Text="Список заблокованих програм"
                           Foreground="Gray"
                           FontSize="14"
                           Margin="0,0,0,10"/>

                <ScrollViewer Height="150"
                              Background="#222634"
                              >
                    <TextBlock x:Name="DataTextBox"
                               Foreground="White"
                               FontSize="14"
                               Padding="10"
                               TextWrapping="Wrap"
                               />
                </ScrollViewer>

                <TextBlock Text="Назва програми для видалення"
                           Foreground="Gray"
                           Margin="0,20,0,5"/>

                <TextBox x:Name="DeteleAppTextBox"
                         Height="40"
                         Background="#222634"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="10"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">

                    <Button x:Name="UpdateButton"
                            Content="Оновити"
                            Width="120"
                            Height="40"
                            Margin="5"
                            
                            Click="UpdateButton_Click"/>

                    <Button Content="Видалити"
                            Width="140"
                            Height="40"
                            Margin="5"
                            Background="#BF616A"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Button_Click">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#BF616A"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#D9777F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>

    <Window.Resources>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#222634"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E3445"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

</Window>