<Window x:Class="BLockGame.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="About"
        Height="550"
        Width="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F172A" Offset="0"/>
                <GradientStop Color="#111827" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="250"
                 Height="250"
                 Fill="#1E3A8A"
                 Opacity="0.15"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-70,-70,0,0"/>

        <Ellipse Width="300"
                 Height="300"
                 Fill="#2563EB"
                 Opacity="0.10"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-90,-90"/>
        <Border Width="760"
                Height="420"
                CornerRadius="25"
                Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="1"
                Padding="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">

                    <Border Width="60"
                            Height="60"
                            CornerRadius="15"
                            Background="#2563EB"
                            VerticalAlignment="Center">

                        <TextBlock Text="A"
                                   Foreground="White"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,7,0,0"/>
                    </Border>

                    <StackPanel Margin="20,0,0,0">

                        <TextBlock Text="AppBlocker"
                                   Foreground="White"
                                   FontSize="34"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Система контролю та блокування програм"
                                   Foreground="#94A3B8"
                                   FontSize="15"/>
                    </StackPanel>
                </StackPanel>

                <!-- Separator -->
                <Border Grid.Row="1"
                        Height="1"
                        Margin="0,25,0,25"
                        Background="#334155"/>

                <!-- Description -->
                <StackPanel Grid.Row="2">

                    <TextBlock Text="Про програму"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20"/>

                    <TextBlock TextWrapping="Wrap"
                               Foreground="#CBD5E1"
                               FontSize="17"
                               LineHeight="30"
                               Text="
AppBlocker дозволяє користувачам обмежувати доступ до певних програм на комп'ютері.

Програма допомагає:
• підвищити продуктивність;
• обмежити запуск ігор та небажаних програм;
• створити безпечне середовище для дітей;
• контролювати доступ до процесів Windows;
• вести журнал блокувань та активності.

Система підтримує сучасний інтерфейс, роботу з базою даних та механізм автоматичного контролю процесів.
"/>

                </StackPanel>

                <!-- Footer -->
                <Grid Grid.Row="3"
                      Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Version 1.0"
                               Foreground="#64748B"
                               FontSize="14"
                               VerticalAlignment="Center"/>

                    <Border Grid.Column="1"
                            Background="#2563EB"
                            CornerRadius="12"
                            Padding="18,8"
                            Cursor="Hand">

                        <TextBlock Text="BLOCK GAME"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="14"/>
                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>
</Window>